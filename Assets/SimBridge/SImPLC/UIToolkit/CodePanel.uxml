        <ui:VisualElement style="flex-grow: 1; position: absolute; height: 713px; width: 75px; top: 25px; left: auto; right: 25px; background-color: rgb(62, 62, 62); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; bottom: 25px;">
