        <ui:VisualElement style="flex-grow: 1; width: 30%; align-items: stretch; align-content: flex-start; flex-direction: row; flex-wrap: nowrap; align-self: auto; justify-content: flex-start; background-color: rgb(56, 56, 56);">
            <ui:VisualElement style="flex-grow: 1; left: -1px; height: auto; background-color: rgb(56, 56, 56); position: relative; width: 10%; border-right-width: 1px; border-right-color: rgb(0, 0, 0); min-width: 50px; border-top-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
            <ui:VisualElement style="left: auto; height: auto; background-color: rgb(56, 56, 56); position: relative; width: 90%; border-right-width: 0; border-right-color: rgb(0, 0, 0); justify-content: flex-start; align-items: stretch; flex-direction: column;">
                <ui:VisualElement style="flex-grow: 1; height: auto; position: relative; top: auto; max-height: 75px; flex-direction: row;">
                    <ui:Label text="Code file" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); font-size: 20px; -unity-text-align: upper-left;"/>
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row-reverse;">
